{
    "name": "@hodfords/nestjs-command",
    "version": "11.0.10",
    "description": "A utility for running CLI commands in NestJS apps",
    "main": "index.js",
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc",
        "postbuild": "cp package.json dist && cp -r lib/stubs dist/stubs && cp -r lib/bin dist/bin && cp README.md dist && cp .npmrc dist",
        "prepare": "is-ci || husky",
        "format": "prettier --write \"lib/**/*.ts\"",
        "cspell": "cspell",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-command.git"
    },
    "bin": {
        "wz-command": "./bin/cli"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-command/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-command#readme",
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.2",
        "@hodfords/nestjs-prettier-config": "11.0.1",
        "@nestjs/common": "11.1.12",
        "@nestjs/core": "11.1.12",
        "@types/lodash": "4.17.23",
        "@types/node": "25.2.0",
        "cspell": "9.6.3",
        "eslint": "9.39.2",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "16.2.7",
        "lodash": "4.17.23",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.2",
        "rxjs": "7.8.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "^0.3.28",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "pluralize": "^8.0.0"
    },
    "peerDependencies": {
        "@nestjs/common": "*",
        "@nestjs/core": "*",
        "@nestjs/schedule": "*",
        "commander": "*"
    },
    "optionalDependencies": {
        "typeorm": "*"
    }
}
