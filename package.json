{
  "name": "@hodfords/nestjs-command",
  "version": "11.0.3",
  "description": "A utility for running CLI commands in NestJS apps",
  "main": "index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "postbuild": "cp package.json dist && cp -r lib/stubs dist/stubs && cp -r lib/bin dist/bin && cp README.md dist && cp .npmrc dist",
    "prepare": "is-ci || husky",
    "format": "prettier --write \"lib/**/*.ts\"",
    "cspell": "cspell",
    "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
    "lint-staged": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodfords-solutions/nestjs-command.git"
  },
  "bin": {
    "wz-command": "./bin/cli"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hodfords-solutions/nestjs-command/issues"
  },
  "homepage": "https://github.com/hodfords-solutions/nestjs-command#readme",
  "devDependencies": {
    "@hodfords/nestjs-eslint-config": "11.0.0",
    "@hodfords/nestjs-prettier-config": "11.0.0",
    "@nestjs/common": "11.0.8",
    "@nestjs/core": "11.0.8",
    "@types/lodash": "4.17.15",
    "@types/node": "22.13.1",
    "cspell": "8.17.3",
    "eslint": "9.20.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "15.4.3",
    "lodash": "4.17.21",
    "prettier": "3.5.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "0.3.20",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "pluralize": "8.0.0"
  },
  "peerDependencies": {
    "commander": "13.1.0",
    "@nestjs/common": "*",
    "@nestjs/core": "*",
    "@nestjs/schedule": "*",
    "chalk": "^4.1.2"
  },
  "optionalDependencies": {
    "typeorm": "*"
  }
}
