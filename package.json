{
    "name": "@hodfords/nestjs-command",
    "version": "12.3.0",
    "packageManager": "pnpm@12.0.0",
    "description": "A utility for running CLI commands in NestJS apps",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "tsc",
        "postbuild": "cp package.json dist && cp -r lib/stubs dist/stubs && cp -r lib/bin dist/bin && cp README.md dist && cp .npmrc dist",
        "prepare": "is-ci || husky",
        "format": "prettier --write \"lib/**/*.ts\"",
        "cspell": "cspell",
        "lint": "eslint \"lib/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-command.git"
    },
    "bin": {
        "wz-command": "./bin/cli"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-command/issues"
    },
    "homepage": "https://github.com/hodfords-solutions/nestjs-command#readme",
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/node": "26.4.0",
        "@types/pluralize": "^0.0.33",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "1.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "es-toolkit": "1.52.0",
        "pluralize": "^8.0.0"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/schedule": "*",
        "commander": "*",
        "typeorm": ">=1.0.0"
    },
    "optionalDependencies": {
        "typeorm": "*"
    }
}
